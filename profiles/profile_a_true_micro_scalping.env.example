# Profile A: True Micro Scalping
# Local paper testing and diagnostics only. Do not use this as proof of profitability.
# Uses small $10 orders and capped exposure for tightly scoped BTC/USD paper tests.
# Execution TP/SL is intentionally aligned with ML label TP/SL:
#   SCALPING_TAKE_PROFIT_PCT == SCALPING_LABEL_TAKE_PROFIT_PCT
#   SCALPING_STOP_LOSS_PCT == SCALPING_LABEL_STOP_LOSS_PCT
# This profile keeps the app paper-only; live trading is not implemented.

PAPER_TRADING_ONLY=true

TRADING_ENABLED=true
AUTO_TRADE_ENABLED=true
SCALPING_MODE_ENABLED=true

SYMBOL=BTC/USD

ORDER_NOTIONAL_USD=10
MAX_POSITION_NOTIONAL_USD=20
MAX_TOTAL_EXPOSURE_USD=20

ORDER_TYPE=limit
TIME_IN_FORCE=ioc
LIMIT_PRICE_OFFSET_BPS=2

MAX_SPREAD_BPS=4
MAX_SLIPPAGE_BPS=6
MIN_QUOTE_IMBALANCE=0.05

SCALPING_BUY_PROBABILITY_FLOOR=0.56
SCALPING_CONFIDENCE_GAP_REQUIRED=0.08
SCALPING_SELL_PROBABILITY_FLOOR=0.55
SCALPING_EXIT_CONFIDENCE_GAP_REQUIRED=0.04

SCALPING_ENTRY_DIP_PCT=0.0010

SCALPING_TAKE_PROFIT_PCT=0.0015
SCALPING_STOP_LOSS_PCT=0.0010
SCALPING_TRAILING_STOP_PCT=0.0008
TRAILING_STOP_ARM_PROFIT_PCT=0.0010
EMERGENCY_STOP_LOSS_PCT=0.0030

SCALPING_MAX_POSITION_SECONDS=180
SCALPING_MIN_HOLD_SECONDS=30
MIN_HOLD_SECONDS_BEFORE_WEAK_QUOTE_EXIT=60
SCALPING_PROFIT_GUARD_ENABLED=true

SCALPING_LABEL_HORIZON_BARS=3
SCALPING_LABEL_TAKE_PROFIT_PCT=0.0015
SCALPING_LABEL_STOP_LOSS_PCT=0.0010
SCALPING_LABEL_MIN_NET_PROFIT_PCT=0.0002

MAX_TRADES_PER_HOUR=3
MAX_DAILY_TRADES=20
MIN_SECONDS_BETWEEN_TRADES=300

MAX_RECENT_IOC_CANCELS=2
IOC_CANCEL_COOLDOWN_SECONDS=180
IOC_CANCEL_ESCALATION_COOLDOWN_SECONDS=900

MAX_CONSECUTIVE_LOSSES=2
SCALPING_PAUSE_AFTER_LOSS_STREAK_SECONDS=1800
MAX_DAILY_LOSS_USD=5
MAX_ACCOUNT_DAILY_LOSS_USD=10
